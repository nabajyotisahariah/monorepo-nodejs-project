# proxy_pass ${USER_SERVICE_URL}/;
# Because your location ends with / and your proxy_pass URL also ends with /,
# NGINX replaces the matching location prefix with the URI portion of the upstream URL.

# proxy_pass ${USER_SERVICE_URL}; 
# Without the trailing slash: the original URI is preserved. 
# With the trailing slash: the matching location prefix is replaced by /

# proxy_pass	                Incoming path	        Upstream path       Application level               ingressClassName    Docker      Ingress 
# http://user-service:3000/	    /api/users/123	        /123                app.use(routes);                   gce                 No        No
# http://user-service:3000	    /api/users/123	        /api/users/123      app.use("/api/users", routes)      gce                 Yes        Yes
# Ref helm/ecommerce1.0/ingress/ingress.yaml or helm/ecommerce1.1-gce/

# NGINX proxy_pass http://user-service:3000/, where the matching URI prefix is replaced before forwarding the request, 
# The Ingress uses ingressClassName: gce, which means it uses the Google Cloud Application Load
# Balancer (GCE Ingress). Its annotations do not support NGINX's rewrite-target behavior.

# http://user-service:3000/	    /api/users/123	        /123                app.use(routes);                   nginx               Yes          Yes
# Ref  helm/ecommerce1.0/ingress-nginx/ingress.yaml

server {
    listen 80;
    server_name _;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location /api/users/ {
        #proxy_pass ${USER_SERVICE_URL}/;
        proxy_pass ${USER_SERVICE_URL};     
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/products/ {
        #proxy_pass ${PRODUCT_SERVICE_URL}/;
        proxy_pass ${PRODUCT_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/orders/ {
        #proxy_pass ${ORDER_SERVICE_URL}/;
        proxy_pass ${ORDER_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
