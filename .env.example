
NODE_ENV=development

# Services are running 3000 while running from docker compose, but on Kubernates we will use 80 
# for all services, so we can use the same env variables for both environments.
USER_SERVICE_URL=http://user-service:3000       
PRODUCT_SERVICE_URL=http://product-service:3000
ORDER_SERVICE_URL=http://order-service:3000

USER_SERVICE_PORT=3000
PRODUCT_SERVICE_PORT=3000
ORDER_SERVICE_PORT=3000
