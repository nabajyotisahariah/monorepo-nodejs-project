  docker tag user-service:1.0 \
      asia-south2-docker.pkg.dev/weather-project-prod-511603/ecommerce-nodejs-app-repo/user-service:1.0

  $ docker images 
  IMAGE                                                                                                  ID             DISK USAGE   CONTENT SIZE   EXTRA
