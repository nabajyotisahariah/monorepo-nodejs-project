# 5. Order service

This service communicates with the other two services.

### `apps/order-service/package.json`

```json
{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
```

### `apps/order-service/src/server.js`

```javascript
import express from "express";

const app = express();

const PORT = process.env.PORT || 3000;

const USER_SERVICE_URL =
  process.env.USER_SERVICE_URL || "http://localhost:3001";

const PRODUCT_SERVICE_URL =
  process.env.PRODUCT_SERVICE_URL || "http://localhost:3002";

app.use(express.json());

app.get("/health", (req, res) => {
  res.json({
    service: "order-service",
    status: "UP"
  });
});

app.post("/orders", async (req, res) => {
  try {
    const { userId, productId, quantity = 1 } = req.body;

    const userResponse = await fetch(
      `${USER_SERVICE_URL}/users/${userId}`
    );

    const productResponse = await fetch(
      `${PRODUCT_SERVICE_URL}/products/${productId}`
    );

    if (!userResponse.ok || !productResponse.ok) {
      return res.status(400).json({
        message: "Unable to retrieve user or product"
      });
    }

    const user = await userResponse.json();
    const product = await productResponse.json();

    const totalAmount = product.price * quantity;

    res.status(201).json({
      user,
      product,
      quantity,
      totalAmount
    });

  } catch (error) {

    console.error(error);

    res.status(500).json({
      message: "Order creation failed"
    });
  }
});

app.listen(PORT, () => {
  console.log(`Order service running on port ${PORT}`);
});
```

