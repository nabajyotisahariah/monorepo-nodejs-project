# 2. `Chart.yaml`

Create:

```text
helm/ecommerce/Chart.yaml
```

```yaml
apiVersion: v2

name: ecommerce

description: Node.js microservices application

type: application

version: 1.0.0

appVersion: "1.0"
```

---

# 3. `values.yaml`

This is where we keep configuration instead of hard-coding it in Kubernetes YAML.

```yaml

#Ref
#Docker image:
# order   : asia-south2-docker.pkg.dev/python-project-1st-sep/ecommerce-nodejs-app-repo/order-service:1.0
# product : asia-south2-docker.pkg.dev/python-project-1st-sep/ecommerce-nodejs-app-repo/product-service:1.0
# user    : asia-south2-docker.pkg.dev/python-project-1st-sep/ecommerce-nodejs-app-repo/user-service:1.0

global:
  image:
    registry: asia-south2-docker.pkg.dev
    project: python-project-1st-sep
    repository: ecommerce-nodejs-app-repo
    pullPolicy: IfNotPresent

services:

  user:
    name: user-service
    replicas: 2

    image:
      repository: user-service
      tag: "1.0"

    port: 3000

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi

  product:
    name: product-service
    replicas: 2

    image:
      repository: product-service
      tag: "1.0"

    port: 3000

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi

  order:
    name: order-service
    replicas: 2

    image:
      repository: order-service
      tag: "1.0"

    port: 3000

    env:
      USER_SERVICE_URL: http://user-service:80
      PRODUCT_SERVICE_URL: http://product-service:80

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi


service:
  type: ClusterIP
  port: 80


ingress:
  enabled: true
  className: ""

  paths:
    - path: /users
      service: user-service

    - path: /products
      service: product-service

    - path: /orders
      service: order-service


probes:
  readiness:
    path: /health
    initialDelaySeconds: 5
    periodSeconds: 10

  liveness:
    path: /health
    initialDelaySeconds: 10
    periodSeconds: 20
```

Replace:

```text
REGION
PROJECT_ID
```

For example:

```yaml
global:
  imageRegistry: "us-central1-docker.pkg.dev/my-project/microservices"
```

