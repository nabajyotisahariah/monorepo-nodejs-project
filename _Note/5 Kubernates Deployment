    MODE: STANDARD_REPOSITORY
    DESCRIPTION: Microservices Nodejs
    LOCATION: asia-south2

    Ref: asia-south2-docker.pkg.dev/weather-project-prod-511603/ecommerce-nodejs-app-repo
    
